{
  "kind": "collectionType",
  "collectionName": "systems",
  "info": {
    "singularName": "system",
    "pluralName": "systems",
    "displayName": "system"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
