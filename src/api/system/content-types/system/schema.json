      "type": "string",
      "required": true
    },
    "description": {
      "type": "string"
    },
    "layers": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::layer.layer",
      "mappedBy": "systems"
    },
    "quest": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::quest.quest",
      "mappedBy": "system"
    },
    "artsystems": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::artsystem.artsystem",
