{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "product"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "weight": {
      "type": "decimal",
      "required": true
    },
    "consumption": {
      "type": "decimal",
      "required": true
    },
    "price": {
      "type": "integer",
      "required": true
    },
    "packageVolume": {
      "type": "string",
      "required": true
    },
    "layers": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::layer.layer",
      "mappedBy": "products"
    }
  }
}
